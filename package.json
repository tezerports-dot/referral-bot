{
  "name": "referral-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute referral_bot_db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute referral_bot_db --remote --file=./schema.sql",
    "test": "node tests/sql.test.mjs && node tests/migration.test.mjs && node tests/config.test.mjs && node tests/phone.test.mjs && node tests/requirement.test.mjs && node tests/cache.test.mjs && node tests/webhook.test.mjs && node tests/join-flow.test.mjs",
    "test:sql": "node tests/sql.test.mjs",
    "test:migration": "node tests/migration.test.mjs",
    "db:migrate": "wrangler d1 execute referral_bot_db --file=./migrations/0002_dynamic_requirements.sql",
    "db:migrate:remote": "wrangler d1 execute referral_bot_db --remote --file=./migrations/0002_dynamic_requirements.sql",
    "test:config": "node tests/config.test.mjs",
    "test:phone": "node tests/phone.test.mjs",
    "test:requirement": "node tests/requirement.test.mjs",
    "test:cache": "node tests/cache.test.mjs",
    "test:webhook": "node tests/webhook.test.mjs",
    "test:flow": "node tests/join-flow.test.mjs"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.136.3"
  }
}
